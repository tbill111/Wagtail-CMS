# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-flash-latest
AI_MOCK=False

# ----- AI dự phòng (tuỳ chọn): dùng khi Gemini lỗi. Chuẩn API tương thích OpenAI -----
# Chọn MỘT trong các cấu hình mẫu dưới đây, bỏ dấu # và điền key. Để trống key để tắt.
FALLBACK_AI_API_KEY=
FALLBACK_AI_BASE_URL=
FALLBACK_AI_MODEL=
FALLBACK_AI_NAME=
# Groq (miễn phí, không cần thẻ) – lấy key: https://console.groq.com/keys
#   FALLBACK_AI_BASE_URL=https://api.groq.com/openai/v1
#   FALLBACK_AI_MODEL=llama-3.3-70b-versatile
#   FALLBACK_AI_NAME=Groq Llama 3.3
# OpenRouter (có model miễn phí, tên kết thúc bằng :free) – https://openrouter.ai/keys
#   FALLBACK_AI_BASE_URL=https://openrouter.ai/api/v1
#   FALLBACK_AI_MODEL=<tên model :free, xem https://openrouter.ai/models?max_price=0>
#   FALLBACK_AI_NAME=OpenRouter
# DeepSeek (trả phí theo lượt, cần nạp tiền) – https://platform.deepseek.com/api_keys
#   FALLBACK_AI_BASE_URL=https://api.deepseek.com
#   FALLBACK_AI_MODEL=deepseek-chat
#   FALLBACK_AI_NAME=DeepSeek
DJANGO_SECRET_KEY=
DEBUG=True

# ----- CSDL (TH1 Superset) -----
# Để trống / sqlite: dùng db.sqlite3. Đặt postgres để dùng PostgreSQL trong docker-compose.yml
DB_ENGINE=sqlite
DB_NAME=smartcrm
DB_USER=smartcrm
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5435

# ----- Apache Superset (chỉ docker-compose.yml đọc) -----
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=
SUPERSET_META_PASSWORD=
# Mật khẩu tài khoản CHỈ ĐỌC mà Superset dùng để kết nối CSDL CRM
SUPERSET_RO_PASSWORD=
# Cổng Superset trên máy (đổi nếu 8088 đã bị chiếm)
SUPERSET_PORT=8088

# ----- Nhúng dashboard Superset vào SmartCRM (trang /crm/analytics/) -----
# Khoá ký guest token (chuỗi ngẫu nhiên dài, khác SUPERSET_SECRET_KEY)
SUPERSET_GUEST_TOKEN_SECRET=
# Địa chỉ SmartCRM được phép nhúng Superset, cách nhau bằng dấu phẩy
SUPERSET_EMBED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Địa chỉ Superset mà trình duyệt và Wagtail truy cập; để trống = http://127.0.0.1:<SUPERSET_PORT>
SUPERSET_URL=

# ----- Thông tin cá nhân (TH1 – bài cá nhân) -----
STUDENT_NAME=Giang Thanh Tùng
STUDENT_ID=2351160563
TH1_SEED=2351160563

